---
import '../styles/site.css';
const {pageTitle='GoldfishStudio',lang='nl',pageDescription,year='2026'} = Astro.props;
const en=lang==='en';
const base=en?'/en':'';
const home=base+'/';
const path=Astro.url.pathname.replace(/\/+$/,'')||'/';
const nlPath=path==='/en'?'/':path.replace(/^\/en\//,'/');
const enPath=path.startsWith('/en')?path:path==='/'?'/en/':'/en'+path;
const otherPath=en?nlPath:enPath;
const title=pageTitle.includes('GoldfishStudio')?pageTitle:pageTitle.replace(/ — Goldfishstudio/g,'')+' — GoldfishStudio';
const description=pageDescription||(en?'Video and photography for events, interviews, podcasts and brands. Based in the Netherlands, available worldwide.':'Video en fotografie voor events, interviews, podcasts en merken. Vanuit Nederland, beschikbaar wereldwijd.');
const links=[{href:base+'/work',label:en?'Work':'Werk'},{href:home+'#aanpak',label:en?'Approach':'Aanpak'},{href:base+'/about',label:en?'About me':'Over mij'}];
---
<!doctype html>
<html lang={lang} data-type="service">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#10120f"/>
<meta name="page-type" content="service"/><meta name="site-kind" content="other"/>
<link rel="icon" href="/favicon.png"/><link rel="canonical" href={'https://goldfishstudio.nl'+path}/>
<link rel="alternate" hreflang="nl" href={'https://goldfishstudio.nl'+nlPath}/><link rel="alternate" hreflang="en" href={'https://goldfishstudio.nl'+enPath}/><link rel="alternate" hreflang="x-default" href="https://goldfishstudio.nl/"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={'https://goldfishstudio.nl'+path}/><meta property="og:image" content="https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=1200"/><meta name="twitter:card" content="summary_large_image"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
</head>
<body id="page-top">
<a class="skip-link" href="#main-content">{en?'Skip to content':'Ga naar de inhoud'}</a>
<header class="header wrap">
<a class="brand" href={home} aria-label="GoldfishStudio"><img src="/brand/goldfish-logo.png" alt="" width="49" height="40"/><span>Goldfish<span>studio</span></span></a>
<nav class="navigation" aria-label={en?'Main navigation':'Hoofdnavigatie'}>{links.map(link=><a href={link.href} aria-current={path===link.href?'page':undefined}>{link.label}</a>)}</nav>
<div class="nav-right"><a class="language" href={otherPath} aria-label={en?'Nederlands':'English'}>{en?'NL':'EN'}</a><a class="button button-small" href={base+'/contact'}>{en?'Start a project':'Start een project'} <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary>{en?'Menu':'Menu'}</summary><nav class="mobile-nav-panel" aria-label={en?'Mobile navigation':'Mobiele navigatie'}>{links.map(link=><a href={link.href}>{link.label}</a>)}<a href={base+'/contact'}>{en?'Contact':'Contact'}</a></nav></details></div>
</header>
<main id="main-content"><slot/></main>
<footer class="footer wrap"><div class="footer-top"><a class="brand" href={home}><img src="/brand/goldfish-logo.png" alt="" width="49" height="40"/><span>Goldfish<span>studio</span></span></a><span>{en?'Based in the Netherlands · available worldwide':'Nederland · beschikbaar wereldwijd'}</span><div><a href="https://instagram.com/remastered_goldfish">Instagram ↗</a><a href={base+'/work'}>Portfolio ↗</a><a href={base+'/contact'}>Contact ↗</a></div></div><div class="footer-bottom"><span>© {year} GoldfishStudio</span><a href="#page-top">{en?'Back to top ↑':'Terug naar boven ↑'}</a></div></footer>
</body>
</html>
