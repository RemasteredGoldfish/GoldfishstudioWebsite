---
import { translations } from '../i18n.ts';
import { ClientRouter } from 'astro:transitions';

const { pageTitle, year = '2026', lang = 'en', pageDescription = null } = Astro.props;
const t = translations[lang];
const otherLang = lang === 'en' ? 'nl' : 'en';
const otherPath = lang === 'en' ? '' : '/en';
const navLinks = [
  { href: lang === 'en' ? '/en/work' : '/work', label: t.nav.work },
  { href: lang === 'en' ? '/en/about' : '/about', label: t.nav.about },
];
const siteUrl = 'https://goldfishstudio.nl';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => {
  const clean = href.replace(/\/+$/, '') || '/';
  return currentPath === clean;
};

// SEO: hreflang helpers
const getEnPath = () => {
  if (currentPath === '/') return '/en/';
  if (currentPath === '/en') return '/en/';
  if (currentPath.startsWith('/en/')) return currentPath;
  return '/en' + currentPath;
};

const getNlPath = () => {
  if (currentPath === '/') return '/';
  if (currentPath === '/en') return '/';
  if (currentPath.startsWith('/en/')) return currentPath.replace('/en', '');
  return currentPath;
};

// SEO: page-specific descriptions
const descriptions = {
  en: {
    '/en/': 'Freelance videographer in Amsterdam, Netherlands. I create cinematic commercial videos, music videos, and brand films that tell your story.',
    '/': 'Videograaf in Nederland. Ik maak cineastische commerciële video\'s, muziekvideo\'s en merkfilms die jouw verhaal vertellen.',
    '/en/work': 'Portfolio of recent videography projects — commercials, brand films, music videos, and event coverage.',
    '/work': 'Portfolio met recente videografie projecten — reclames, merkfilms, muziekvideo\'s en evenementen.',
    '/en/about': 'About J. Murray — freelance videographer and filmmaker based in the Netherlands specializing in cinematic storytelling.',
    '/about': 'Over J. Murray — videograaf en filmmaker in Nederland gespecialiseerd in cinematische verhalen.',
    '/en/contact': 'Get in touch with Goldfishstudio. Book a consultation or inquire about your next video project.',
    '/contact': 'Neem contact op met Goldfishstudio. Boek een gesprek of vraag naar jouw volgende videoprojet.',
  },
  nl: {
    '/': 'Videograaf in Nederland. Ik maak cineastische commerciële video\'s, muziekvideo\'s en merkfilms die jouw verhaal vertellen.',
    '/work': 'Portfolio met recente videografieprojecten — reclames, merkfilms, muziekvideo\'s en evenementen.',
    '/about': 'Over J. Murray — videograaf en filmmaker in Nederland, gespecialiseerd in cinematische storytelling.',
    '/contact': 'Neem contact op met Goldfishstudio. Boek een gesprek of vraag naar jouw volgende videoproject.',
  }
};

const getDescription = () => {
  if (pageDescription) return pageDescription;
  const normalized = currentPath === '/' ? (lang === 'en' ? '/en/' : '/') : currentPath;
  return descriptions[lang]?.[normalized] || descriptions[lang]?.['/'] || descriptions.en['/en/'];
};

const metaDescription = getDescription();
const canonicalPath = currentPath === '/en' ? '/en/' : (currentPath === '/' && lang === 'en' ? '/en/' : currentPath);
const canonicalUrl = siteUrl + canonicalPath;
const documentTitle = pageTitle === 'Goldfishstudio' ? 'Goldfishstudio' : `${pageTitle} — Goldfishstudio`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0c0c0c" />
  <title>{documentTitle}</title>
  <ClientRouter />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://player.vimeo.com" />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" /></noscript>
  <meta property="og:title" content={documentTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content="https://goldfishstudio.nl/og-image.jpg" />
  <meta property="og:locale" content={lang === 'en' ? 'en_NL' : 'nl_NL'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={siteUrl + getEnPath()} />
  <link rel="alternate" hreflang="nl" href={siteUrl + getNlPath()} />
  <link rel="alternate" hreflang="x-default" href={siteUrl + '/'} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://goldfishstudio.nl",
    name: "Goldfishstudio",
    description: metaDescription,
    url: "https://goldfishstudio.nl",
    email: "info@goldfishstudio.nl",
    sameAs: ["https://instagram.com/remastered_goldfish"],
    address: {
      "@type": "PostalAddress",
      addressCountry: "NL",
      addressRegion: "Netherlands"
    },
    priceRange: "€€",
    areaServed: ["NL", "EU"],
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "Customer Support",
      email: "info@goldfishstudio.nl"
    },
    knowsAbout: ["Videography", "Film Production", "Commercial Video", "Music Videos", "Brand Films", "Event Coverage"],
    serviceType: ["Commercial Videography", "Music Video Production", "Brand Film Production", "Event Videography"]
  })} />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #080808; --bg-warm: #11110f; --fg: #f4efe5;
      --fg-muted: #aaa397; --fg-dim: #716c63;
      --accent: #d3a42d; --accent-light: #e5bd50;
      --border: #2b2925; --border-light: #464139;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Inter', system-ui, sans-serif;
    }
    html { font-size: 16px; }
    body { font-family: var(--font-sans); background: var(--bg); color: var(--fg); line-height: 1.7; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    img, video { max-width: 100%; display: block; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    a:focus-visible, button:focus-visible { border-radius: 2px; }

    /* Skip link */
    .skip-link {
      position: absolute; top: -100px; left: 1rem; z-index: 1000;
      background: var(--accent); color: #0c0c0c; padding: .6rem 1rem;
      font-size: .8rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
      transition: top .2s;
    }
    .skip-link:focus { top: 1rem; }

    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: flex-start; justify-content: space-between; padding: 2rem 3rem; transition: background .4s, background-color .4s; will-change: background-color; }
    .nav.scrolled { background: rgba(8,8,8,.94); backdrop-filter: blur(12px); }
    .nav-logo { display: inline-flex; align-items: center; color: var(--fg); }
    .nav-logo img { width: 4.2rem; height: 2.8rem; object-fit: contain; object-position: center; }
    .nav-right { display: flex; align-items: center; gap: 2rem; }
    .nav-links { display: flex; gap: 2.5rem; list-style: none; }
    .nav-links a { font-size: .7rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--fg); transition: color .3s; padding: .25rem 0; }
    .nav-links a:hover { color: var(--fg); }
    .nav-links a.active { color: var(--accent); }
    .lang-btn { font-size: .7rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; padding: .4rem .8rem; border: 1px solid var(--border); color: var(--fg-muted); background: transparent; cursor: pointer; transition: all .3s; font-family: inherit; }
    .lang-btn:hover { border-color: var(--accent); color: var(--accent); }
    .nav-cta { font-size: .75rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; padding: .7rem 1.5rem; border: 1px solid var(--border); color: var(--fg); transition: border-color .3s, color .3s; }
    .nav-cta:hover { border-color: var(--accent); color: var(--accent); }

    /* Hamburger (mobile) */
    .nav-toggle {
      display: none;
      background: transparent; border: 1px solid var(--border); color: var(--fg);
      width: 42px; height: 42px; cursor: pointer; align-items: center; justify-content: center;
      padding: 0; transition: border-color .3s;
    }
    .nav-toggle:hover { border-color: var(--accent); }
    .nav-toggle svg { width: 20px; height: 20px; }
    .nav-toggle .icon-close { display: none; }
    .nav-toggle[aria-expanded="true"] .icon-open { display: none; }
    .nav-toggle[aria-expanded="true"] .icon-close { display: block; }

    /* Mobile menu */
    .mobile-menu {
      display: none;
      position: fixed; top: 0; right: 0; bottom: 0;
      width: min(86vw, 360px);
      background: rgba(12,12,12,.98);
      z-index: 99;
      padding: 6rem 2rem 2rem;
      flex-direction: column; gap: 2rem;
      transform: translateX(100%); transition: transform .35s ease;
      border-left: 1px solid var(--border);
      overflow-y: auto;
    }
    .mobile-menu.open { transform: translateX(0); }
    .mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; }
    .mobile-menu a { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 400; color: var(--fg); transition: color .3s; }
    .mobile-menu a:hover, .mobile-menu a.active { color: var(--accent); }
    .mobile-menu .mobile-meta { margin-top: auto; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 1rem; }
    .mobile-menu .mobile-meta a { font-family: var(--font-sans); font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-muted); }
    .mobile-backdrop {
      display: none;
      position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 98;
      opacity: 0; transition: opacity .35s;
    }
    .mobile-backdrop.open { opacity: 1; }
    body.menu-open { overflow: hidden; }

    .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
    section { padding: 8rem 0; }
    .eyebrow { font-size: .7rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.5rem; }
    .heading { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; line-height: 1.25; margin-bottom: 1.5rem; }
    .heading em { font-style: italic; color: var(--accent); }
    .lede { font-size: 1.05rem; color: var(--fg-muted); max-width: 560px; line-height: 1.9; }

    .hero { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; position: relative; padding-top: 6rem; overflow: hidden; background: var(--bg); }
    .hero-bg { position: absolute; inset: 0; z-index: 0; will-change: transform; }
    .hero-bg iframe { width: 100%; height: 100%; border: none; display: block; }
    .hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(8,8,8,.2), rgba(8,8,8,.72) 72%, rgba(8,8,8,1)); pointer-events: none; }
    .hero-content { position: relative; z-index: 2; }
    .hero-inner { max-width: 750px; }
    .hero-eyebrow { font-size: .7rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); margin-bottom: 2rem; }
    .hero-title { font-family: var(--font-serif); font-size: clamp(2.8rem, 6vw, 4.5rem); font-weight: 300; line-height: 1.15; margin-bottom: 1.8rem; color: var(--fg); }
    .hero-title em { font-style: italic; color: var(--accent); }
    .hero-sub { font-size: 1.05rem; color: var(--fg-muted); max-width: 520px; line-height: 1.9; margin-bottom: 2.5rem; }
    .hero-actions { display: flex; gap: 1.2rem; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; padding: .9rem 2rem; font-family: var(--font-sans); font-size: .75rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; transition: all .3s; cursor: pointer; border-radius: 0; border: 1px solid transparent; min-height: 44px; }
    .btn-primary { background: var(--accent); color: #0c0c0c; border-color: var(--accent); }
    .btn-primary:hover { background: var(--accent-light); border-color: var(--accent-light); }
    .btn-ghost { background: transparent; color: var(--fg); border-color: var(--border); }
    .btn-ghost:hover { border-color: var(--border-light); }

    /* Figma-inspired editorial system */
    .figma-home { position: relative; }
    .figma-home .hero-content { width: 100%; }
    .figma-home .hero-inner { max-width: 980px; padding-top: 8rem; }
    .figma-home .hero-eyebrow, .figma-section .eyebrow { letter-spacing: .28em; font-size: .65rem; }
    .figma-home .hero-eyebrow::before, .figma-section .eyebrow::before { content: ''; display: block; width: 3.35rem; height: 3px; background: var(--accent); margin-bottom: 1.8rem; }
    .figma-home .hero-title { font-size: clamp(4rem, 10vw, 9.5rem); line-height: .82; letter-spacing: -.045em; max-width: 1050px; margin-bottom: 2.5rem; }
    .figma-home .hero-title em { display: block; color: var(--fg); font-style: normal; }
    .figma-home .hero-sub { max-width: 420px; font-size: .85rem; line-height: 1.8; }
    .figma-home .hero-actions .btn { border-width: 0 0 1px; padding: .8rem 0; margin-right: 1.5rem; }
    .figma-home .hero-actions .btn-primary { color: var(--accent); background: transparent; border-color: var(--accent); }
    .figma-home .hero-actions .btn-ghost { border-color: var(--fg-muted); }
    .figma-side-note { position: absolute; right: 3rem; bottom: 3rem; writing-mode: vertical-rl; color: var(--fg-dim); font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; }
    .figma-scroll { position: absolute; left: 3rem; bottom: 2.5rem; color: var(--fg-dim); font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; display: flex; align-items: center; gap: .8rem; }
    .figma-scroll::after { content: ''; width: 3rem; height: 1px; background: var(--accent); }
    .figma-section { padding: 10rem 0; border-top: 1px solid var(--border); }
    .figma-section .heading { font-size: clamp(3rem, 7vw, 7rem); line-height: .9; letter-spacing: -.04em; max-width: 850px; }
    .figma-section .heading em { color: var(--fg); font-style: normal; }
    .figma-projects { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem; margin-top: 5rem; }
    .figma-projects .video-card { grid-column: span 4; }
    .figma-projects .video-card:nth-child(2) { grid-column: span 5; margin-top: 8rem; }
    .figma-projects .video-card:nth-child(3) { grid-column: span 3; margin-top: 3rem; }
    .figma-projects .video-card-media { border-radius: 0; }
    .figma-projects .video-title { font-size: 1.7rem; }
    .figma-projects .video-client, .figma-projects .video-role { color: var(--fg-dim); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; margin-top: .35rem; }
    .figma-projects .video-card-media iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .text-link { display: inline-flex; gap: .8rem; margin-top: 4rem; color: var(--accent); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid var(--accent); padding-bottom: .6rem; }
    .text-link span { font-size: 1rem; line-height: .7; }
    .figma-cta { padding: 11rem 0 12rem; background: var(--fg); color: var(--bg); }
    .figma-cta .eyebrow, .figma-cta .lede { color: var(--bg); }
    .figma-cta .heading { color: var(--bg); max-width: 850px; }
    .figma-cta .btn { color: var(--bg); border-color: var(--bg); }
    .figma-cta .btn:hover { background: var(--bg); color: var(--fg); }
    .page-intro { padding: 12rem 0 6rem; }
    .page-intro .heading { font-size: clamp(3.5rem, 8vw, 8rem); line-height: .88; max-width: 950px; }
    .page-intro .heading em { color: var(--fg); font-style: normal; }
    .project-page { padding: 11rem 0 8rem; }
    .project-detail { max-width: 1180px; margin: 0 auto; }
    .project-back { display: inline-flex; margin-bottom: 4rem; padding: .75rem 0; border-bottom: 1px solid var(--border); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--fg-muted); }
    .project-back:hover { color: var(--accent); border-color: var(--accent); }
    .project-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
    .project-header .heading { font-size: clamp(3.5rem, 8vw, 8rem); line-height: .82; letter-spacing: -.045em; margin: 0; }
    .project-meta { display: flex; flex-wrap: wrap; gap: .5rem; color: var(--fg-muted); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; padding-bottom: .35rem; }
    .project-divider { color: var(--accent); }
    .project-video { width: 100%; aspect-ratio: 16 / 9; background: #000; overflow: hidden; border: 1px solid var(--border); }
    .project-video.vertical { width: min(100%, 520px); aspect-ratio: 9 / 16; }
    .project-video-iframe { width: 100%; height: 100%; border: 0; display: block; }
    .project-info { display: grid; grid-template-columns: 1.5fr 1fr; gap: 5rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); }
    .project-description { color: var(--fg-muted); font-size: 1rem; line-height: 1.9; max-width: 560px; }
    .project-role { color: var(--fg-muted); font-size: .8rem; line-height: 1.8; }
    .project-role strong { display: block; color: var(--accent); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; margin-bottom: .5rem; }
    .project-contact { margin-top: 4rem; }
    .logo-intro { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; background: var(--bg); opacity: 1; transition: opacity .55s ease; }
    .logo-intro.is-hidden { opacity: 0; pointer-events: none; }
    .logo-intro video { width: min(820px, 92vw); height: auto; display: block; }

    .video-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .video-card { cursor: pointer; }
    .video-card.vertical { grid-row: span 1; }
    .video-card:hover .video-title { color: var(--accent); }
    .video-thumb { aspect-ratio: 16/10; overflow: hidden; background: var(--bg-warm); margin-bottom: 1.2rem; position: relative; }
    .video-card-media { position: relative; aspect-ratio: 16/10; overflow: hidden; background: var(--bg-warm); margin-bottom: 1.2rem; cursor: pointer; }
    .video-card-media.vertical { aspect-ratio: 9/16; }
    .video-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
    .video-card:hover .video-thumb img { transform: scale(1.03); }
    .video-thumb-placeholder { color: var(--fg-dim); font-size: .75rem; letter-spacing: .1em; text-align: center; }
    .video-thumb-loading { position: absolute; inset: 0; background: var(--bg-warm); display: flex; align-items: center; justify-content: center; }
    .video-thumb-loading::after { content: ''; width: 24px; height: 24px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .video-meta { display: flex; align-items: center; gap: .5rem; margin-bottom: .4rem; }
    .video-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--fg-dim); }
    .video-tag { font-size: .7rem; color: var(--fg-dim); letter-spacing: .08em; text-transform: uppercase; }
    .video-year { font-size: .7rem; color: var(--fg-dim); }
    .video-title { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 400; line-height: 1.3; transition: color .3s; }

    .editorial { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
    .editorial-text p { color: var(--fg-muted); margin-bottom: 1.2rem; font-size: 1rem; line-height: 2.1; }
    .editorial-text strong { color: var(--fg); font-weight: 500; }
    .editorial-image { aspect-ratio: 4/5; background: var(--bg-warm); border-radius: 2px; overflow: hidden; display: flex; align-items: center; justify-content: center; color: var(--fg-dim); font-size: .85rem; }
    .editorial-image img { width: 100%; height: 100%; object-fit: cover; }

    .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem 4rem; max-width: 800px; }
    .service-item .eyebrow { font-size: .65rem; margin-bottom: .6rem; }
    .service-item h3 { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 400; margin-bottom: .6rem; }
    .service-item p { font-size: .92rem; color: var(--fg-muted); line-height: 1.9; }

    .testimonial { text-align: center; max-width: 700px; margin: 0 auto; padding: 4rem 0; }
    .testimonial-quote { font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 300; line-height: 1.5; color: var(--fg); margin-bottom: 1.5rem; }
    .testimonial-quote em { font-style: italic; color: var(--accent); }
    .testimonial-author { font-size: .8rem; color: var(--fg-dim); letter-spacing: .08em; }

    .cta-band { padding: 6rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); text-align: center; }
    .cta-band .heading { margin-bottom: 1rem; }
    .cta-band .lede { margin: 0 auto 2.5rem; }

    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; }
    .contact-form { display: flex; flex-direction: column; gap: 1.5rem; }
    .field label { display: block; font-size: .7rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-muted); margin-bottom: .5rem; }
    .field input, .field textarea { width: 100%; padding: .9rem 0; background: transparent; border: none; border-bottom: 1px solid var(--border); color: var(--fg); font-family: var(--font-sans); font-size: 1rem; transition: border-color .3s; min-height: 44px; }
    .field textarea { min-height: 120px; resize: vertical; }
    .field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); }
    .contact-details { display: flex; flex-direction: column; gap: 1.5rem; }
    .contact-label { font-size: .7rem; color: var(--fg-dim); letter-spacing: .1em; text-transform: uppercase; }
    .contact-value { font-size: 1rem; color: var(--fg); }
    .contact-value a:hover { color: var(--accent); }

    /* Pricing */
    .pricing-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    .pricing-card { padding: 1.5rem; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; transition: border-color .3s; }
    .pricing-card:hover { border-color: var(--accent); }
    .pricing-card h3 { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 400; margin-bottom: .5rem; }
    .pricing-price { font-size: .85rem; color: var(--accent); letter-spacing: .05em; }

    /* FAQ */
    .faq-grid { display: flex; flex-direction: column; gap: 0; max-width: 700px; }
    .faq-item { border-bottom: 1px solid var(--border); padding: 1.5rem 0; }
    .faq-item summary { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 400; cursor: pointer; color: var(--fg); list-style: none; display: flex; justify-content: space-between; align-items: center; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; font-family: var(--font-sans); font-size: 1.2rem; color: var(--accent); transition: transform .3s; flex-shrink: 0; margin-left: 1rem; }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { margin-top: 1rem; font-size: .92rem; color: var(--fg-muted); line-height: 1.9; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    .stat-card { padding: 1.5rem; background: var(--bg-warm); border-radius: 8px; border: 1px solid transparent; transition: border-color .3s; }
    .stat-card:hover { border-color: var(--border); }
    .stat-num { font-family: var(--font-serif); font-size: 2.2rem; font-weight: 400; color: var(--accent); line-height: 1; margin-bottom: .5rem; }
    .stat-label { font-size: .8rem; color: var(--fg-muted); }

    footer { padding: 3rem 2rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
    .footer-copy { font-size: .75rem; color: var(--fg-dim); letter-spacing: .05em; }
    .footer-btw { font-size: .65rem; color: var(--fg-dim); letter-spacing: .05em; margin-top: .3rem; opacity: .6; }
    .footer-links { display: flex; gap: 2rem; list-style: none; }
    .footer-links a { font-size: .75rem; color: var(--fg-dim); letter-spacing: .08em; }
    .footer-links a:hover { color: var(--accent); }

    /* Film Grain Overlay */
    .grain-overlay {
      position: fixed; inset: 0; z-index: 9998; pointer-events: none;
      opacity: 0.03;
      background-image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAADIAAAAyCAYAAAAeP4ixAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAYklEQVR4nO3BMQEAAADCoPVPbQwfoAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAP8DwQoAAeKZbJQAAAABJRU5ErkJggg==");
      background-repeat: repeat;
      mix-blend-mode: overlay;
    }
    /* Cinematic Image Filter */
    .cinematic-img { width: 100%; height: 100%; object-fit: cover; filter: sepia(15%) saturate(85%) contrast(105%); transition: transform 0.8s ease; will-change: transform; }
    
    /* Video Card Play State */
    .video-card-media { position: relative; aspect-ratio: 16/10; overflow: hidden; background: var(--bg-warm); margin-bottom: 1.2rem; cursor: pointer; }
    .video-card-media.vertical { aspect-ratio: 9/16; }
    .video-poster { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease, filter 0.4s ease; will-change: transform, filter; }
    .video-card:hover .video-poster { transform: scale(1.04); filter: brightness(0.85); }
    .play-btn {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 64px; height: 64px; border-radius: 50%; background: rgba(196, 164, 110, 0.9);
      border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: transform 0.3s ease, background 0.3s ease; will-change: transform, background; z-index: 2;
    }
    .video-card:hover .play-btn { transform: translate(-50%, -50%) scale(1.1); background: var(--accent); }
    .play-btn svg { width: 24px; height: 24px; fill: #0c0c0c; margin-left: 3px; }
    .video-iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; z-index: 1; }
    .vertical .video-iframe { width: 100%; height: 100%; left: 0; } /* Ensures iframe fills vertical cards properly */
    
    /* Mobile video responsiveness */
    @media (max-width: 900px) {
      .video-card-media { aspect-ratio: 16/9; }
      .video-card-media.vertical { aspect-ratio: 9/16; }
    }
    @media (max-width: 480px) {
      .video-card-media { aspect-ratio: auto; height: 60vw; min-height: 240px; }
      .video-card-media.vertical { height: 90vw; max-width: 80vw; margin: 0 auto 1.2rem; }
      .play-btn { width: 48px; height: 48px; }
      .play-btn svg { width: 20px; height: 20px; }
    }

    /* Reveal-on-scroll */
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity .8s ease, transform .8s ease; }
    .reveal.visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
      html { scroll-behavior: auto; }
    }

    @media (max-width: 900px) {
      .nav { padding: 1rem 1.5rem; }
      .nav-links, .nav-cta { display: none; }
      .nav-toggle { display: inline-flex; }
      .mobile-menu, .mobile-backdrop { display: block; }
      section { padding: 5rem 0; }
      .container { padding: 0 1.5rem; }
      .editorial, .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .video-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .video-card.vertical { grid-row: auto; }
      .services-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .pricing-grid { grid-template-columns: repeat(2, 1fr); }
      .hero { min-height: 85vh; min-height: 85svh; padding-top: 5rem; }
      .hero-title { font-size: clamp(2.2rem, 7vw, 3rem); }
      .hero-sub { max-width: 100%; }
      .footer-links { flex-wrap: wrap; gap: 1rem; }
      .figma-home .hero-inner { padding-top: 4rem; }
      .figma-home .hero-title { font-size: clamp(4rem, 16vw, 7rem); }
      .figma-side-note { right: 1.5rem; }
      .figma-scroll { left: 1.5rem; }
      .figma-projects { grid-template-columns: 1fr 1fr; }
      .figma-projects .video-card, .figma-projects .video-card:nth-child(2), .figma-projects .video-card:nth-child(3) { grid-column: span 1; margin-top: 0; }
      .figma-projects .video-card:first-child { grid-column: span 2; }
    }
    @media (max-width: 480px) {
      .nav { padding: .85rem 1rem; }
      .nav-right { gap: .5rem; }
      .nav-logo img { width: 3.2rem; height: 2.2rem; }
      .container { padding: 0 1rem; }
      section { padding: 3.5rem 0; }
      .hero-title { font-size: 2rem; }
      .hero-eyebrow { font-size: .6rem; margin-bottom: 1.2rem; }
      .hero-sub { font-size: .95rem; }
      .heading { font-size: 1.6rem; }
      .lede { font-size: .95rem; }
      .btn { padding: .85rem 1.4rem; font-size: .7rem; }
      .video-title { font-size: 1.15rem; }
      .video-thumb { aspect-ratio: 16/9; }
      .stat-num { font-size: 1.8rem; }
      .video-grid { grid-template-columns: 1fr; gap: 1rem; }
      .video-card-media { margin-bottom: 0.6rem; }
      .nav { padding: 1.2rem 1rem; }
      .figma-home .hero-title { font-size: clamp(3.7rem, 18vw, 6rem); }
      .figma-section { padding: 6rem 0; }
      .figma-section .heading { font-size: clamp(3rem, 15vw, 5rem); }
      .figma-projects { display: block; }
      .figma-projects .video-card { margin-bottom: 3rem !important; }
      .figma-side-note { display: none; }
      .project-page { padding: 8rem 0 5rem; }
      .project-header { display: block; margin-bottom: 2rem; }
      .project-header .heading { font-size: clamp(3.5rem, 16vw, 6rem); margin-bottom: 1.5rem; }
      .project-info { grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem; }
      .project-video.vertical { width: min(100%, 78vw); }
    }
  </style>
</head>
<body>
  <div class="grain-overlay" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <nav class="nav" id="top-nav" aria-label="Primary">
    <a href={lang === 'en' ? '/en' : '/'} class="nav-logo"><img src="/brand/goldfish-logo.png" alt="Goldfishstudio" /></a>
    <div class="nav-right">
      <ul class="nav-links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
      <a href={lang === 'en' ? '/' : '/en'} class="lang-btn" aria-label={lang === 'en' ? 'Switch to Dutch' : 'Switch to English'}>{t.langBtn}</a>
      <a href={lang === 'en' ? '/en/contact' : '/contact'} class="nav-cta">{t.nav.hire}</a>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label={lang === 'en' ? 'Open menu' : 'Open menu'}>
        <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
    </div>
  </nav>

  <div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>
  <aside class="mobile-menu" id="mobile-menu" aria-label="Mobile menu" aria-hidden="true">
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
    <div class="mobile-meta">
      <a href={lang === 'en' ? '/' : '/en'}>{t.langBtn === 'NL' ? 'Nederlands' : 'English'}</a>
      <a href="mailto:info@goldfishstudio.nl">info@goldfishstudio.nl</a>
    </div>
  </aside>

  <main id="main-content">
    <slot />
  </main>

  <footer>
    <div>
      <div class="footer-copy">&copy; {year} Goldfishstudio. {t.footer.copy}</div>
      <div class="footer-btw">BTW: NL005113528B68</div>
    </div>
    <ul class="footer-links">
      <li><a href="mailto:info@goldfishstudio.nl">info@goldfishstudio.nl</a></li>
      <li><a href="https://instagram.com/remastered_goldfish" target="_blank" rel="noopener noreferrer">Instagram</a></li>
      <li><a href={lang === 'en' ? '/en/work' : '/work'}>{t.footer.portfolio}</a></li>
    </ul>
  </footer>

  <script>
    // Nav scroll state — runs on every page (incl. after view transitions)
    function initNav() {
      var nav = document.getElementById('top-nav');
      if (nav) {
        var rafId = null;
        var apply = function() {
          nav.classList.toggle('scrolled', window.scrollY > 80);
          rafId = null;
        };
        var onScroll = function() {
          if (rafId === null) {
            rafId = requestAnimationFrame(apply);
          }
        };
        apply();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    }
    // Mobile menu toggle
    function initMenu() {
      var toggle = document.getElementById('nav-toggle');
      var menu = document.getElementById('mobile-menu');
      var backdrop = document.getElementById('mobile-backdrop');
      if (!toggle || !menu || !backdrop) return;
      var close = function() {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('open');
        menu.setAttribute('aria-hidden', 'true');
        backdrop.classList.remove('open');
        document.body.classList.remove('menu-open');
      };
      var open = function() {
        toggle.setAttribute('aria-expanded', 'true');
        menu.classList.add('open');
        menu.setAttribute('aria-hidden', 'false');
        backdrop.classList.add('open');
        document.body.classList.add('menu-open');
      };
      toggle.addEventListener('click', function() {
        if (toggle.getAttribute('aria-expanded') === 'true') close();
        else open();
      });
      backdrop.addEventListener('click', close);
      // Close on link click
      menu.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', close);
      });
      // Close on Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') close();
      });
    }
    // Reveal-on-scroll
    function initReveal() {
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
        return;
      }
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });
    }
    function initAll() { initNav(); initMenu(); initReveal(); }
    initAll();
    document.addEventListener('astro:after-swap', initAll);
  </script>
  <script src="/_vercel/insights/script.js" defer></script>
  <script src="/_vercel/speed-insights/script.js" defer></script>
</body>
</html>
