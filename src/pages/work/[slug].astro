---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.ts';
import { translations } from '../../i18n.ts';

export const getStaticPaths = async () => {
  return projects.map(project => ({
    params: {
      slug: project.title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
    },
    props: { project }
  }));
};

const t = translations.nl;
const lang = 'nl';
const { project } = Astro.props;
const { title, tag, year, muxId, videoId, vertical } = project;
const description = `A ${tag.toLowerCase()} project titled "${title}" from ${year}.`;
  const videoUrl = muxId 
    ? `https://player.mux.com/${muxId}?muted=true&controls=true&loop=true`
    : `https://www.youtube-nocookie.com/embed/${videoId}?mute=1&fs=0&modestbranding=1&loop=1&playlist=${videoId}`;
---
<Layout t={t} lang={lang} pageTitle={`${title} — Goldfishstudio`} pageDescription={description} year="2026">
  <section class="container" style="padding-top: 6rem; padding-bottom: 6rem;">
    <div class="project-detail">
      {/* Back to portfolio link */}
      <a href="/work" class="btn btn-ghost" style="margin-bottom: 2rem; display: inline-block;">
        ← Terug naar portfolio
      </a>
      
      {/* Project header */}
      <div class="project-header">
        <h1 class="heading">{title}</h1>
        <div class="project-meta">
          <span class="project-tag">{tag}</span>
          <span class="project-divider">•</span>
          <span class="project-year">{year}</span>
        </div>
      </div>
      
      {/* Project video */}
      <div class="project-video">
        <iframe
          class="project-video-iframe"
          src={videoUrl}
          title={title}
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
          allowFullscreen
        />
      </div>
      
      {/* Project description */}
      <div class="project-description">
        {description}
      </div>
      
      {/* Contact CTA */}
      <div class="project-contact">
        <a href="/contact" class="btn btn-primary">
          Bespreek dit project
        </a>
      </div>
    </div>
  </section>
</Layout>