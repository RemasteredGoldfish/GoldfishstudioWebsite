---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.ts';
import { translations } from '../i18n.ts';
const t = translations.nl;
const slugify = (title) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Layout t={t} lang="nl" pageTitle="Werk — Goldfishstudio" year="2026">
  <section class="container page-intro figma-section">
    <div class="eyebrow">Geselecteerd werk</div>
    <h1 class="heading">Recente<br /><em>projecten.</em></h1>
    <p class="lede" style="margin-top:2rem;">Een selectie van commercials, branded content, social films en verhalen die we samen met onze klanten tot leven brachten.</p>
    <div class="figma-projects">
      {projects.map((p) => {
        const videoUrl = p.muxId ? `https://player.mux.com/${p.muxId}?autoplay=true&muted=true&controls=false&loop=true&playsinline=true` : `https://www.youtube-nocookie.com/embed/${p.videoId}?autoplay=1&mute=1&fs=0&modestbranding=1&loop=1&playlist=${p.videoId}`;
        return (
          <a href={`/work/${slugify(p.title)}`} class:list={["video-card", p.vertical && "vertical"]}>
            <div class:list={["video-card-media", p.vertical && "vertical"]}><iframe loading="lazy" title={p.title} src={videoUrl} allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe></div>
            <div class="video-meta"><span class="video-tag">{p.tag}</span><span class="video-meta-dot"></span><span class="video-year">{p.year}</span></div>
            <div class="video-title">{p.title}</div><div class="video-client">{p.client}</div><div class="video-role">{p.role}</div>
          </a>
        );
      })}
    </div>
  </section>
  <section class="figma-cta"><div class="container"><div class="eyebrow">Jouw project hier?</div><h2 class="heading">Laten we iets<br /><em>onvergetelijks maken.</em></h2><a href="/contact" class="btn btn-ghost" style="margin-top:2.5rem;">Start een project →</a></div></section>
</Layout>