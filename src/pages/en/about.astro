---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n.ts';
const t = translations.en;
---
<Layout t={t} lang="en" pageTitle="About — Goldfishstudio" year="2026">

  <section class="container page-intro figma-section">
    <div class="editorial">
      <div>
        <div class="eyebrow" set:html={t.about.eyebrow} />
        <h1 class="heading" set:html={t.about.heading} />
        <p set:html={t.about.p1} />
        <p set:html={t.about.p2} />
        <p set:html={t.about.p3} />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="border-top: 1px solid var(--border);">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-num">50+</div>
          <div class="stat-label">Projects completed</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">Concept → final cut</div>
          <div class="stat-label">End-to-end production</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">Worldwide</div>
          <div class="stat-label">Available for projects worldwide</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">Your vision</div>
          <div class="stat-label">Focused on your vision</div>
        </div>
      </div>
    </div>
  </section>

</Layout>