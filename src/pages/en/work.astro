---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.ts';
import { translations } from '../../i18n.ts';
const t = translations.en;
---
<Layout t={t} lang="en" pageTitle="Work — Goldfishstudio" year="2026">

  <section class="container" style="padding-top: 8rem;">
    <div class="eyebrow" set:html={t.work.eyebrow} />
    <h1 class="heading" style="font-size: clamp(2rem, 5vw, 3.5rem);" set:html={t.work.heading} />

    <!-- Featured video -->
    <div style="margin-top: 3rem;">
      {projects.map((p, index) => {
        if (index === 0) {
          const featured = p;
          const featuredCardClasses = ['video-card'];
          if (featured.vertical) featuredCardClasses.push('vertical');
          const featuredMediaClasses = ['video-card-media'];
          if (featured.vertical) featuredMediaClasses.push('vertical');
          const featuredIframeClasses = ['video-iframe'];
          if (featured.vertical) featuredIframeClasses.push('vertical');
          return (
            <article class:list={featuredCardClasses}>
              <div class:list={featuredMediaClasses} style="position:relative;">
                {featured.muxId ? (
                  <iframe class:list={featuredIframeClasses} title={featured.title} src={`https://player.mux.com/${featured.muxId}?autoplay=true&muted=true&controls=false&loop=true&playsinline=true`} allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen style="display:block; width:100%; height:100%; border:none;"></iframe>
                ) : (
                  <iframe class:list={featuredIframeClasses} title={featured.title} src={`https://www.youtube-nocookie.com/embed/${featured.videoId}?autoplay=1&mute=1&controls=0&fs=0&modestbranding=1&loop=1&playlist=${featured.videoId}`} allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" style="display:block; width:100%; height:100%; border:none;"></iframe>
                )}
              </div>
              <div class="video-meta">
                <span class="video-tag">{featured.tag}</span>
                <span class="video-meta-dot"></span>
                <span class="video-year">{featured.year}</span>
              </div>
              <div class="video-title">{featured.title}</div>
              <div class="video-client">{featured.client}</div>
              <div class="video-role">{featured.role}</div>
            </article>
          );
        }
        return null;
      })}
    </div>

    <!-- More work -->
    <div style="margin-top: 4rem;">
      <div class="eyebrow" style="font-size:.65rem; margin-bottom:1.5rem;">MORE WORK</div>
      <div class="video-grid">
        {projects.slice(1).map((p) => {
          const cardClasses = ['video-card'];
          if (p.vertical) cardClasses.push('vertical');
          const mediaClasses = ['video-card-media'];
          if (p.vertical) mediaClasses.push('vertical');
          const iframeClasses = ['video-iframe'];
          if (p.vertical) iframeClasses.push('vertical');
          return (
            <article class:list={cardClasses}>
              <div class:list={mediaClasses} style="position:relative;">
                {p.muxId ? (
                  <iframe class:list={iframeClasses} title={p.title} src={`https://player.mux.com/${p.muxId}?autoplay=true&muted=true&controls=false&loop=true&playsinline=true`} allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen style="display:block; width:100%; height:100%; border:none;"></iframe>
                ) : (
                  <iframe class:list={iframeClasses} title={p.title} src={`https://www.youtube-nocookie.com/embed/${p.videoId}?autoplay=1&mute=1&controls=0&fs=0&modestbranding=1&loop=1&playlist=${p.videoId}`} allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" style="display:block; width:100%; height:100%; border:none;"></iframe>
                )}
              </div>
              <div class="video-meta">
                <span class="video-tag">{p.tag}</span>
                <span class="video-meta-dot"></span>
                <span class="video-year">{p.year}</span>
              </div>
              <div class="video-title">{p.title}</div>
              <div class="video-client">{p.client}</div>
              <div class="video-role">{p.role}</div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

</Layout>
