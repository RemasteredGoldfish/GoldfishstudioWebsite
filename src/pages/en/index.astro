---
<Layout t={t} lang="en" pageTitle="Goldfishstudio" year="2026">

  <section class="hero">
    <div class="hero-bg" aria-hidden="true" id="hero-bg">
      <!-- Iframe loads after page paints for better LCP -->
    </div>
    <div class="hero-overlay" />
    <div class="container hero-content">
      <div class="hero-inner">
        <div class="hero-eyebrow" set:html={t.hero.eyebrow} />
        <h1 class="hero-title" set:html={t.hero.title} />
        <p class="hero-sub" set:html={t.hero.sub} />
        <div class="hero-actions">
          <a href="/en/work" class="btn btn-primary" set:html={t.hero.cta1} />
          <a href="/en/contact" class="btn btn-ghost" set:html={t.hero.cta2} />
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="container">
      <div class="eyebrow" set:html={t.work.eyebrow} />
      <h2 class="heading" set:html={t.work.heading} />
      <div class="video-grid">
        {projects.map((p) => {
          const cardClasses = ['video-card'];
          if (p.vertical) cardClasses.push('vertical');
          const mediaClasses = ['video-card-media'];
          if (p.vertical) mediaClasses.push('vertical');
          const iframeClasses = ['video-iframe'];
          if (p.vertical) iframeClasses.push('vertical');
          return (
            <article class:list={cardClasses}>
              <div class:list={mediaClasses} style="cursor:pointer;position:relative;" data-mux={p.muxId} data-video-id={p.videoId} data-title={p.title}>
                {p.muxId ? (
                  <iframe loading="lazy" class:list={iframeClasses} title={p.title} src={`https://player.mux.com/${p.muxId}?autoplay=true&muted=true&controls=false&loop=true&playsinline=true`} allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen;" allowfullscreen style="display:block; width:100%; height:100%; border:none;"></iframe>
                ) : (
                  <iframe loading="lazy" class:list={iframeClasses} title={p.title} src={`https://www.youtube-nocookie.com/embed/${p.videoId}?autoplay=1&mute=1&fs=0&modestbranding=1&loop=1&playlist=${p.videoId}`} allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" style="display:block; width:100%; height:100%; border:none;"></iframe>
                )}
              </div>
              <div class="video-meta">
                <span class="video-tag" set:html={p.tag} />
                <span class="video-meta-dot"></span>
                <span class="video-year" set:html={p.year} />
              </div>
              <div class="video-title" set:html={p.title} />
              <div class="video-client" set:html={p.client} />
              <div class="video-role" set:html={p.role} />
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="container">
      <h2 class="heading" set:html={t.cta.heading} />
      <p class="lede" style="margin:0 auto 2.5rem;" set:html={t.cta.sub} />
      <a href="/en/contact" class="btn btn-ghost" set:html={t.cta.btn} />
    </div>
  </div>

  <script>
    // Load hero Mux video after page paints (requestIdleCallback with fallback)
    function loadHeroBg() {
      const heroBg = document.getElementById('hero-bg');
      if (!heroBg) return;
      
      const loadIframe = () => {
        heroBg.innerHTML = '<iframe loading="eager" src="https://player.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg?autoplay=true&muted=true&loop=true&controls=false&playsinline=1&background_audio=false" title="Goldfishstudio background" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" allowfullscreen style="width:100%;height:100%;border:none;position:absolute;top:0;left:0;"></iframe>';
      };
      
      // Defer loading until after initial paint to avoid blocking main thread
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadIframe, { timeout: 1000 });
      } else {
        requestAnimationFrame(() => setTimeout(loadIframe, 50));
      }
    }
    
    // Click to open full player
    function initVideoGrid() {
      document.addEventListener('click', (e) => {
        const card = e.target.closest('.video-card-media[data-mux], .video-card-media[data-video-id]');
        if (!card) return;
        
        const muxId = card.dataset.mux;
        const videoId = card.dataset.videoId;
        const title = card.dataset.title;
        
        if (muxId) {
          // Mux video - open modal with Mux player
          openModal(`https://player.mux.com/${muxId}?autoplay=true&controls=true`, title);
        } else if (videoId) {
          // YouTube video - open modal with YouTube embed
          openModal(`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&fs=1&modestbranding=1`, title);
        }
      });
    }
    
    function openModal(src, title) {
      const modal = document.createElement('div');
      modal.className = 'video-modal';
      modal.innerHTML = `
        <div class="video-modal-overlay" onclick="this.parentElement.remove()"></div>
        <div class="video-modal-content">
          <button class="video-modal-close" onclick="this.closest('.video-modal').remove()" aria-label="Close video">×</button>
          <iframe src="${src}" title="${title}" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe>
        </div>
      `;
      document.body.appendChild(modal);
      document.body.style.overflow = 'hidden';
      modal.querySelector('.video-modal-overlay').addEventListener('click', () => {
        modal.remove();
        document.body.style.overflow = '';
      });
      modal.querySelector('.video-modal-close').addEventListener('click', () => {
        modal.remove();
        document.body.style.overflow = '';
      });
      document.addEventListener('keydown', function esc(e) {
        if (e.key === 'Escape') {
          modal.remove();
          document.body.style.overflow = '';
          document.removeEventListener('keydown', esc);
        }
      });
    }
    
    loadHeroBg();
    initVideoGrid();
  </script>

</Layout>