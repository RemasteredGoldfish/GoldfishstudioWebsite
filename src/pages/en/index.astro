---
import Layout from '../../layouts/Layout.astro';
---
<Layout lang="en" pageTitle="GoldfishStudio — your story in focus">

  <section class="hero wrap" id="top" aria-labelledby="hero-title">
    <div class="hero-topline"><p class="eyebrow"><span class="gold-dot"></span> Films with a pulse</p><p class="location">Netherlands <span aria-hidden="true">↗</span> Worldwide</p></div>
    <div class="hero-grid">
      <div class="hero-copy" data-enter>
        <h1 id="hero-title">Your story.<br> <em>In focus.</em></h1>
        <p class="hero-description">From events and aftermovies to interviews, podcasts and commercials. GoldfishStudio captures what makes your brand, story or moment special.</p>
        <div class="hero-actions"><a class="button" href="#werk">View the work <span aria-hidden="true">↓</span></a><a class="underlink" href="/en/contact">Start a project <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-visual">
        <div class="film-frame" id="hero-film">
          <img class="hero-poster" src="https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=1600&time=10" alt="Still from a GoldfishStudio production" fetchpriority="high">
          <div class="background-player" id="background-player" aria-hidden="true"></div>
          <button class="motion-toggle" id="motion-toggle" aria-label="Play background video" aria-pressed="false"><span class="motion-symbol" aria-hidden="true">▶</span><span class="motion-label">Play video</span></button>
        </div>
        <div class="film-foot"><span>Video · Photography · Production</span><span>GoldfishStudio <span aria-hidden="true">©</span></span></div>
      </div>
    </div>
    <div class="hero-bottom"><span>Stories that keep moving.</span><a href="#werk">Scroll to see more <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="work dark-section" id="werk" aria-labelledby="work-title">
    <div class="wrap section-inner">
      <div class="section-top"><p class="eyebrow">Selected work <span class="short-rule"></span></p><span class="small-note">A selection from the portfolio</span></div>
      <div class="work-heading"><h2 id="work-title">Three projects.<br> <em>Three different worlds.</em></h2><div class="work-controls"><button class="previews-toggle" id="previews-toggle" aria-pressed="true">Ⅱ Pause previews</button><a class="underlink" href="/en/work">View all projects <span aria-hidden="true">↗</span></a></div></div>
      <div class="project-grid">
        <article class="project">
          <div class="project-heading"><div><span class="project-kind">Reel · 2026</span><h3>Coach Kux</h3></div><span class="project-number">01</span></div>
          <button class="project-film" data-playback="PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc" data-title="Coach Kux" data-page="/en/work/coach-kux" aria-label="Play Coach Kux"><img src="https://image.mux.com/PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc/thumbnail.jpg?width=900" alt="Coach Kux — video still" loading="lazy"><span class="play-button" aria-hidden="true">↗</span></button>
        </article>
        <article class="project">
          <div class="project-heading"><div><span class="project-kind">Commercial · 2026</span><h3>BODY & FIT</h3></div><span class="project-number">02</span></div>
          <button class="project-film" data-playback="XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc" data-title="BODY & FIT — Vooruitgang" data-page="/en/work/body-fit-vooruitgang-vertical" aria-label="Play BODY & FIT"><img src="https://image.mux.com/XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc/thumbnail.jpg?width=900" alt="BODY & FIT — video still" loading="lazy"><span class="play-button" aria-hidden="true">↗</span></button>
        </article>
        <article class="project">
          <div class="project-heading"><div><span class="project-kind">Commercial · 2026</span><h3>Martabak</h3></div><span class="project-number">03</span></div>
          <button class="project-film" data-playback="LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw" data-title="Martabak" data-page="/en/work/martabak" aria-label="Play Martabak"><img src="https://image.mux.com/LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw/thumbnail.jpg?width=900" alt="Martabak Restaurant — video still" loading="lazy"><span class="play-button" aria-hidden="true">↗</span></button>
        </article>
      </div>
    </div>
  </section>

  <section class="approach wrap section-inner" id="aanpak" aria-labelledby="approach-title">
    <div class="section-top"><p class="eyebrow">What I do <span class="short-rule"></span></p><span class="small-note">From first idea to final frame</span></div>
    <div class="approach-grid">
      <div class="approach-intro"><h2 id="approach-title">The idea.<br> The shoot.<br> <em>The video.</em></h2><p>From concept and direction to editing, colour and sound design. With versions for every screen.</p><a class="underlink" href="/en/contact">Start a project <span aria-hidden="true">↗</span></a></div>
      <div class="services">
        <div class="service"><span class="service-number">01</span><div><h3>Concept & direction</h3><p>A clear idea, a creative direction and a video that fits your brand.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
        <div class="service"><span class="service-number">02</span><div><h3>Video & production</h3><p>From a social shoot to a full commercial, with attention to every detail.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
        <div class="service"><span class="service-number">03</span><div><h3>Edit & finishing</h3><p>Editing, colour, sound design and versions for every screen.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
        <div class="service"><span class="service-number">04</span><div><h3>Social-first content</h3><p>Vertical and horizontal videos for your social channels.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap contact-inner"><p class="eyebrow">Let’s make something</p><div class="contact-grid"><h2 id="contact-title">Tell me what<br> you <em>have in mind.</em></h2><div class="contact-side"><p>An idea, a deadline or a feeling? Let’s talk.</p><a class="button" href="/en/contact">Start a project <span aria-hidden="true">↗</span></a><a class="email-link" href="mailto:info@goldfishstudio.nl">info@goldfishstudio.nl</a></div></div></div></section>

<dialog id="film-dialog" aria-labelledby="film-title"><div class="dialog-top"><h2 id="film-title">Film</h2><button class="dialog-close" aria-label="Close video">Close <span aria-hidden="true">×</span></button></div><div id="film-player"></div><a id="film-project" class="dialog-project" href="/en/work">View project ↗</a></dialog>

<script is:inline src="/home.js"></script>
</Layout>
