---
import Layout from '../layouts/Layout.astro';
import { translations } from '../i18n.ts';
const t = translations.nl;
---
<Layout t={t} lang="nl" pageTitle="Over ons — Goldfishstudio" year="2026">

  <section class="container page-intro figma-section">
    <div class="editorial">
      <div>
        <div class="eyebrow" set:html={t.about.eyebrow} />
        <h1 class="heading" set:html={t.about.heading} />
        <p set:html={t.about.p1} />
        <p set:html={t.about.p2} />
        <p set:html={t.about.p3} />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="border-top: 1px solid var(--border);">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-num">50+</div>
          <div class="stat-label">Projecten voltooid</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">Concept → eindmontage</div>
          <div class="stat-label">Van idee tot eindfilm</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">Wereldwijd</div>
          <div class="stat-label">Beschikbaar voor projecten wereldwijd</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">Jouw visie</div>
          <div class="stat-label">Focus op jouw visie</div>
        </div>
      </div>
    </div>
  </section>

</Layout>