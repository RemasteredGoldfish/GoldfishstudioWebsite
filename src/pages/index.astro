---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="nl" pageTitle="GoldfishStudio — jouw verhaal in beeld">

  <section class="hero wrap" id="top" aria-labelledby="hero-title">
    <div class="hero-topline"><p class="eyebrow"><span class="gold-dot"></span> Films with a pulse</p><p class="location">Nederland <span aria-hidden="true">↗</span> Wereldwijd</p></div>
    <div class="hero-grid">
      <div class="hero-copy" data-enter>
        <h1 id="hero-title">Jouw verhaal.<br> <em>In beeld.</em></h1>
        <p class="hero-description">Van events en aftermovies tot interviews, podcasts en commercials. GoldfishStudio legt vast wat jouw merk, verhaal of moment bijzonder maakt.</p>
        <div class="hero-actions"><a class="button" href="#werk">Bekijk het werk <span aria-hidden="true">↓</span></a><a class="underlink" href="/contact">Start een project <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-visual">
        <div class="film-frame" id="hero-film">
          <img class="hero-poster" src="https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=1200&time=10" srcset="https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=480&time=10 480w, https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=800&time=10 800w, https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=1200&time=10 1200w, https://image.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg/thumbnail.jpg?width=1600&time=10 1600w" sizes="(max-width: 740px) 90vw, 45vw" width="1600" height="900" alt="Filmstill uit een productie van GoldfishStudio" fetchpriority="high">
          <div class="background-player" id="background-player" aria-hidden="true"></div>
          <button class="motion-toggle" id="motion-toggle" aria-label="Achtergrondfilm afspelen" aria-pressed="false"><span class="motion-symbol" aria-hidden="true">▶</span><span class="motion-label">Speel film</span></button>
        </div>
        <div class="film-foot"><span>Video · Fotografie · Productie</span><span>GoldfishStudio <span aria-hidden="true">©</span></span></div>
      </div>
    </div>
    <div class="hero-bottom"><span>Verhalen die blijven bewegen.</span><a href="#werk">Scroll om te ontdekken <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="work dark-section" id="werk" aria-labelledby="work-title">
    <div class="wrap section-inner">
      <div class="section-top"><p class="eyebrow">Geselecteerd werk <span class="short-rule"></span></p><span class="small-note">Een selectie uit ons portfolio</span></div>
      <div class="work-heading"><h2 id="work-title">Drie projecten.<br> <em>Drie eigen werelden.</em></h2><div class="work-controls"><button class="previews-toggle" id="previews-toggle" aria-pressed="true">Ⅱ Pauzeer previews</button><a class="underlink" href="/work">Bekijk alle projecten <span aria-hidden="true">↗</span></a></div></div>
      <div class="project-grid">
        <article class="project">
          <div class="project-heading"><div><span class="project-kind">Reel · 2026</span><h3>Coach Kux</h3></div><span class="project-number">01</span></div>
          <button class="project-film" data-playback="PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc" data-title="Coach Kux" data-page="/work/coach-kux" aria-label="Speel de film Coach Kux af"><img src="https://image.mux.com/PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc/thumbnail.jpg?width=900" srcset="https://image.mux.com/PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc/thumbnail.jpg?width=480 480w, https://image.mux.com/PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc/thumbnail.jpg?width=720 720w, https://image.mux.com/PIp6EDEDue008BuRkVus5yWVZTSP9QwgxYIUAKvA26yc/thumbnail.jpg?width=900 900w" sizes="(max-width: 740px) 90vw, 30vw" width="900" height="1600" alt="Coach Kux — filmstill" loading="lazy"><span class="play-button" aria-hidden="true">↗</span></button>
        </article>
        <article class="project">
          <div class="project-heading"><div><span class="project-kind">Commercial · 2026</span><h3>BODY & FIT</h3></div><span class="project-number">02</span></div>
          <button class="project-film" data-playback="XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc" data-title="BODY & FIT — Vooruitgang" data-page="/work/body-fit-vooruitgang-vertical" aria-label="Speel de commercial BODY & FIT af"><img src="https://image.mux.com/XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc/thumbnail.jpg?width=900" srcset="https://image.mux.com/XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc/thumbnail.jpg?width=480 480w, https://image.mux.com/XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc/thumbnail.jpg?width=720 720w, https://image.mux.com/XsaF3Fpnl6LvuGkWdTfbC5CbeJBwpIKbpRxV02GfIIyc/thumbnail.jpg?width=900 900w" sizes="(max-width: 740px) 90vw, 30vw" width="900" height="1600" alt="BODY & FIT — filmstill" loading="lazy"><span class="play-button" aria-hidden="true">↗</span></button>
        </article>
        <article class="project">
          <div class="project-heading"><div><span class="project-kind">Commercial · 2026</span><h3>Martabak</h3></div><span class="project-number">03</span></div>
          <button class="project-film" data-playback="LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw" data-title="Martabak" data-page="/work/martabak" aria-label="Speel de commercial Martabak af"><img src="https://image.mux.com/LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw/thumbnail.jpg?width=900" srcset="https://image.mux.com/LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw/thumbnail.jpg?width=480 480w, https://image.mux.com/LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw/thumbnail.jpg?width=720 720w, https://image.mux.com/LyrdTPrrRFX8rpoK727fJMZcOHgrmv00QzpeVpYRWIXw/thumbnail.jpg?width=900 900w" sizes="(max-width: 740px) 90vw, 30vw" width="900" height="1600" alt="Martabak Restaurant — filmstill" loading="lazy"><span class="play-button" aria-hidden="true">↗</span></button>
        </article>
      </div>
    </div>
  </section>

  <section class="approach wrap section-inner" id="aanpak" aria-labelledby="approach-title">
    <div class="section-top"><p class="eyebrow">Wat we doen <span class="short-rule"></span></p><span class="small-note">Van eerste idee tot laatste frame</span></div>
    <div class="approach-grid">
      <div class="approach-intro"><h2 id="approach-title">Het idee.<br> De opname.<br> <em>De film.</em></h2><p>Van concept en regie tot montage, kleur en sound design. Met versies voor ieder scherm.</p><a class="underlink" href="/contact">Start een project <span aria-hidden="true">↗</span></a></div>
      <div class="services">
        <div class="service"><span class="service-number">01</span><div><h3>Concept & regie</h3><p>Een helder idee, een sterke richting en een film die voelt als jouw merk.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
        <div class="service"><span class="service-number">02</span><div><h3>Film & productie</h3><p>Van kleine social shoot tot volledige commercial, met aandacht voor ieder detail.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
        <div class="service"><span class="service-number">03</span><div><h3>Edit & finishing</h3><p>Montage, kleur, sound design en versies die werken op ieder scherm.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
        <div class="service"><span class="service-number">04</span><div><h3>Social-first content</h3><p>Verticale en horizontale films voor je social kanalen.</p></div><span class="service-star" aria-hidden="true">✳</span></div>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap contact-inner"><p class="eyebrow">Laten we iets maken</p><div class="contact-grid"><h2 id="contact-title">Vertel ons wat<br> je <em>bezighoudt.</em></h2><div class="contact-side"><p>Een idee, een deadline of alleen een gevoel? Begin het gesprek.</p><a class="button" href="/contact">Start een project <span aria-hidden="true">↗</span></a><a class="email-link" href="mailto:info@goldfishstudio.nl">info@goldfishstudio.nl</a></div></div></div></section>

<dialog id="film-dialog" aria-labelledby="film-title"><div class="dialog-top"><h2 id="film-title">Film</h2><button class="dialog-close" aria-label="Sluit de film">Sluiten <span aria-hidden="true">×</span></button></div><div id="film-player"></div><a id="film-project" class="dialog-project" href="/work">Bekijk het project ↗</a></dialog>

<script is:inline src="/home.js"></script>
</Layout>
