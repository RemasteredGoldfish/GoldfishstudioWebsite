---
import Layout from '../layouts/Layout.astro';
import { translations } from '../i18n.ts';
const t = translations.nl;
const lang = 'nl';

const projects = [
  { title: 'Gospel Celebrations Friday Delivery', videoId: 'fvcC-OiFOXM', vertical: false, tag: 'Concert', year: '2026' },
  { title: 'Office Amelia Video', videoId: '2zAnE4BHG3g', vertical: true, tag: 'Social Media', year: '2026' },
  { title: 'Barber Video', videoId: '7gZLxHgUQx8', vertical: true, tag: 'Merkenfilm', year: '2026' },
  { title: 'Martabak', videoId: '9nALKayuaE0', vertical: true, tag: 'Commercial', year: '2026' },
  { title: 'Sabajo Vision', videoId: 'a-9kq35OiDQ', vertical: true, tag: 'Community', year: '2026' },
  { title: 'Together We Build', videoId: 'otjwjZ9A7Gc', vertical: true, tag: 'Evenement', year: '2026' },
  { title: 'Office Website 4K', videoId: 'oLuet3RdY1A', vertical: false, tag: 'Corporate', year: '2026' },
];
---

<Layout t={t} lang="nl" pageTitle="Goldfishstudio" year="2026">

  <section class="hero">
    <div class="hero-bg" aria-hidden="true" id="hero-bg">
      <!-- Iframe loads after page paints for better LCP -->
    </div>
    <div class="hero-overlay" />
    <div class="container hero-content">
      <div class="hero-inner">
        <div class="hero-eyebrow" set:html={t.hero.eyebrow} />
        <h1 class="hero-title" set:html={t.hero.title} />
        <p class="hero-sub" set:html={t.hero.sub} />
        <div class="hero-actions">
          <a href="/work" class="btn btn-primary" set:html={t.hero.cta1} />
          <a href="/contact" class="btn btn-ghost" set:html={t.hero.cta2} />
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="container">
      <div class="eyebrow" set:html={t.work.eyebrow} />
      <h2 class="heading" set:html={t.work.heading} />
      <div class="video-grid">
        {projects.map((p) => (
          <article class:list={["video-card", p.vertical && "vertical"]}>
            <div class:list={["video-card-media", p.vertical && "vertical"]} data-video={p.videoId} style="cursor:pointer;position:relative;">
              <img src={`https://img.youtube.com/vi/${p.videoId}/maxresdefault.jpg`} alt={p.title + ' — Goldfishstudio videography'} class="video-poster" loading="eager" decoding="async" onerror="this.src='https://img.youtube.com/vi/${p.videoId}/hqdefault.jpg'" />
              <button class="play-btn" aria-label={`Play ${p.title}`}>
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <iframe class:list={["video-iframe", p.vertical && "vertical"]} title={p.title} allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" style="display:none;"></iframe>
            </div>
            <div class="video-meta">
              <span class="video-tag" set:html={p.tag} />
              <span class="video-meta-dot"></span>
              <span class="video-year" set:html={p.year} />
            </div>
            <div class="video-title" set:html={p.title} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="container">
      <h2 class="heading" set:html={t.cta.heading} />
      <p class="lede" style="margin:0 auto 2.5rem;" set:html={t.cta.sub} />
      <a href="/contact" class="btn btn-primary" set:html={t.cta.btn} />
    </div>
  </div>

  <script>
    // Load hero Mux video after page paints (requestIdleCallback with fallback)
    function loadHeroBg() {
      const heroBg = document.getElementById('hero-bg');
      if (!heroBg) return;
      
      const loadIframe = () => {
        heroBg.innerHTML = '<iframe src="https://player.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg?autoplay=1&muted=1&loop=1" title="Goldfishstudio background" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" allowfullscreen style="width:100%;height:100%;border:none;position:absolute;top:0;left:0;"></iframe>';
      };
      
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadIframe, { timeout: 2000 });
      } else {
        requestAnimationFrame(() => setTimeout(loadIframe, 100));
      }
    }
    
    // Lazy-load YouTube iframes only on click
    function initVideoGrid() {
      document.addEventListener('click', (e) => {
        const card = e.target.closest('.video-card-media[data-video]');
        if (!card) return;
        
        const videoId = card.dataset.video;
        const iframe = card.querySelector('iframe');
        
        // Already loaded
        if (iframe.src) return;
        
        const poster = card.querySelector('.video-poster');
        const btn = card.querySelector('.play-btn');
        
        // Load iframe
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&fs=0&modestbranding=1`;
        
        // Show iframe when ready
        iframe.onload = () => {
          iframe.style.display = 'block';
          poster.style.display = 'none';
          btn.style.display = 'none';
        };
        
        // Fallback in case onload doesn't fire
        setTimeout(() => {
          if (iframe.style.display !== 'block') {
            iframe.style.display = 'block';
            poster.style.display = 'none';
            btn.style.display = 'none';
          }
        }, 100);
      }, { capture: true });
    }
    
    loadHeroBg();
    initVideoGrid();
  </script>

</Layout>
