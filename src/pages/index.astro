---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.ts';
import { translations } from '../i18n.ts';
const t = translations.nl;
const lang = 'nl';
---
<Layout t={t} lang="nl" pageTitle="Goldfishstudio" year="2026">

  <section class="hero">
    <div class="hero-bg" aria-hidden="true" id="hero-bg">
      <!-- Iframe loads after page paints for better LCP -->
    </div>
    <div class="hero-overlay" />
    <div class="container hero-content">
      <div class="hero-inner">
        <div class="hero-eyebrow" set:html={t.hero.eyebrow} />
        <h1 class="hero-title" set:html={t.hero.title} />
        <p class="hero-sub" set:html={t.hero.sub} />
        <div class="hero-actions">
          <a href="/work" class="btn btn-primary" set:html={t.hero.cta1} />
          <a href="/contact" class="btn btn-ghost" set:html={t.hero.cta2} />
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="container">
      <div class="eyebrow" set:html={t.work.eyebrow} />
      <h2 class="heading" set:html={t.work.heading} />
      <div class="video-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
        {projects.map((p) => {
          const slug = p.title
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
          const videoUrl = p.muxId 
            ? `https://player.mux.com/${p.muxId}?autoplay=true&muted=true&controls=true&loop=true`
            : `https://www.youtube-nocookie.com/embed/${p.videoId}?autoplay=1&mute=1&fs=0&modestbranding=1&loop=1&playlist=${p.videoId}`;
          return (
            <a href={`/work/${slug}`} class={['video-card', p.vertical && 'vertical'].filter(Boolean).join(' ')}>
              <div class={['video-card-media', p.vertical && 'vertical'].filter(Boolean).join(' ')} style="position:relative;">
                <iframe
                  class={['video-iframe', p.vertical && 'vertical'].filter(Boolean).join(' ')}
                  title={p.title}
                  src={videoUrl}
                  allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen;"
                  allowFullscreen
                  style="display:block; width:100%; height:100%; border:none; pointer-events:none;"
                />
              </div>
              <div class="video-meta">
                <span class="video-tag" set:html={p.tag} />
                <span class="video-meta-dot"></span>
                <span class="video-year" set:html={p.year} />
              </div>
              <div class="video-title" set:html={p.title} />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="container">
      <h2 class="heading" set:html={t.cta.heading} />
      <p class="lede" style="margin:0 auto 2.5rem;" set:html={t.cta.sub} />
      <a href="/contact" class="btn btn-primary" set:html={t.cta.btn} />
    </div>
  </div>

  <script>
  import { translations } from '../i18n.ts';
  const t = translations.nl;
  const lang = 'nl';

  // Load hero Mux video after page paints (requestIdleCallback with fallback)
  function loadHeroBg() {
    const heroBg = document.getElementById('hero-bg');
    if (!heroBg) return;

    const loadIframe = () => {
      heroBg.innerHTML = '<iframe src=\"https://player.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg?autoplay=true&muted=true&loop=true&controls=false\" title=\"Goldfishstudio background\" allow=\"accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;\" allowfullscreen style=\"width:100%;height:100%;border:none;position:absolute;top:0;left:0;\"></iframe>';
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadIframe, { timeout: 2000 });
    } else {
      requestAnimationFrame(() => setTimeout(loadIframe, 100));
    }
  }

  loadHeroBg();
</script>

</Layout>