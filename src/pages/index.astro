---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.ts';
import { translations } from '../i18n.ts';
const t = translations.nl;
const lang = 'nl';
const featured = projects.slice(0, 3);
const slugify = (title) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Layout t={t} lang={lang} pageTitle="Goldfishstudio" year="2026">
  <div class="logo-intro" id="logo-intro" aria-hidden="true">
    <video autoplay muted playsinline preload="auto"><source src="/brand/goldfish-logo-animation.mp4" type="video/mp4" /></video>
  </div>
  <section class="hero figma-home">
    <div class="hero-bg" aria-hidden="true" id="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-inner">
        <div class="hero-eyebrow">Films with a pulse</div>
        <h1 class="hero-title">Verhalen die<br /><em>blijven bewegen.</em></h1>
        <p class="hero-sub">Goldfishstudio maakt films voor merken, mensen en ideeën die iets in beweging willen zetten. Gevestigd in Nederland · beschikbaar wereldwijd.</p>
        <div class="hero-actions">
          <a href="/work" class="btn btn-primary">Bekijk geselecteerd werk →</a>
          <a href="/contact" class="btn btn-ghost">Start een gesprek</a>
        </div>
      </div>
    </div>
    <div class="figma-scroll">Scroll om te ontdekken</div>
    <div class="figma-side-note">Film · Direction · Edit</div>
  </section>

  <section class="figma-section" id="work">
    <div class="container">
      <div class="eyebrow">Geselecteerd werk</div>
      <h2 class="heading">Een paar werelden<br />die we <em>helpen maken.</em></h2>
      <div class="figma-projects">
        {featured.map((p) => {
          const videoUrl = p.muxId
            ? `https://player.mux.com/${p.muxId}?autoplay=true&muted=true&controls=false&loop=true&playsinline=true`
            : `https://www.youtube-nocookie.com/embed/${p.videoId}?autoplay=1&mute=1&fs=0&modestbranding=1&loop=1&playlist=${p.videoId}`;
          return (
            <a href={`/work/${slugify(p.title)}`} class:list={["video-card", p.vertical && "vertical"]}>
              <div class:list={["video-card-media", p.vertical && "vertical"]}>
                <iframe loading="lazy" title={p.title} src={videoUrl} allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe>
              </div>
              <div class="video-meta"><span class="video-tag">{p.tag}</span><span class="video-meta-dot"></span><span class="video-year">{p.year}</span></div>
              <div class="video-title">{p.title}</div>
              <div class="video-client">{p.client}</div>
            </a>
          );
        })}
      </div>
      <a href="/work" class="text-link">Bekijk alle projecten <span>↗</span></a>
    </div>
  </section>

  <section class="figma-section">
    <div class="container">
      <div class="eyebrow">Wat we doen</div>
      <h2 class="heading">Van eerste idee<br />tot <em>laatste frame.</em></h2>
      <div class="services-grid" style="margin-top:4rem;">
        <div class="service-item"><div class="eyebrow">01</div><h3>Concept &amp; regie</h3><p>Een helder idee, een sterke richting en een film die voelt als jouw merk.</p></div>
        <div class="service-item"><div class="eyebrow">02</div><h3>Film &amp; productie</h3><p>Van kleine social shoot tot volledige commercial — met aandacht voor ieder detail.</p></div>
        <div class="service-item"><div class="eyebrow">03</div><h3>Edit &amp; finishing</h3><p>Montage, kleur, sound design en versies die werken op ieder scherm.</p></div>
        <div class="service-item"><div class="eyebrow">04</div><h3>Social-first content</h3><p>Verticale en horizontale films die niet alleen mooi zijn, maar blijven hangen.</p></div>
      </div>
    </div>
  </section>

  <section class="figma-cta">
    <div class="container">
      <div class="eyebrow">Laten we iets maken</div>
      <h2 class="heading">Vertel ons wat<br />je <em>bezighoudt.</em></h2>
      <p class="lede" style="margin:2rem 0 2.5rem;">Een idee, een deadline of alleen een gevoel? Begin het gesprek. We reageren binnen 24 uur.</p>
      <a href="/contact" class="btn btn-ghost">Start een project →</a>
    </div>
  </section>

  <script>
    function loadHeroBg() {
      const heroBg = document.getElementById('hero-bg');
      if (!heroBg) return;
      const load = () => { heroBg.innerHTML = '<iframe loading="eager" src="https://player.mux.com/O00qf5HrTommDuoYh6xIq3GloLj1IM5WqzjtS9aBWOwg?autoplay=true&muted=true&loop=true&controls=false&playsinline=1&background_audio=false" title="Goldfishstudio background" allow="autoplay; encrypted-media" allowfullscreen></iframe>'; };
      if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1000 }); else requestAnimationFrame(() => setTimeout(load, 50));
    }
    function initLogoIntro() {
      const intro = document.getElementById('logo-intro');
      const video = intro?.querySelector('video');
      if (!intro || !video) return;
      const finish = () => { intro.classList.add('is-hidden'); setTimeout(() => intro.remove(), 700); };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('goldfish-logo-intro-seen')) { finish(); return; }
      sessionStorage.setItem('goldfish-logo-intro-seen', '1');
      video.addEventListener('ended', finish, { once: true });
      setTimeout(finish, 4200);
    }
    loadHeroBg();
    initLogoIntro();
  </script>
</Layout>