/* GoldfishStudio: charcoal, warm white and gold. */
:root{--gold:#c7a65f;--gold-light:#dcc185;--muted:#a5a59b;--line:#34372f}
body{background:#10120f;color:var(--paper)}
.header{background:#10120f}
.button{background:var(--gold);color:#151710}
.button span{color:#151710}
.button:hover{background:var(--gold-light)}
.hero-description{color:#b3b5a9}
.film-frame{background:#25291f}
.motion-toggle{background:#161a14;color:var(--paper);border:1px solid #535a48}
.work{background:#1a1e17}
.project-heading{border-color:#404735}
.approach{background:#10120f}
.contact-section{background:#20261c}
.contact-side>p,.email-link{color:#b9bdaf}
.footer{background:#10120f}
.navigation a:hover,.language:hover,.underlink:hover{color:var(--gold-light)}
dialog{background:#191b19}

.work-controls{display:flex;align-items:center;gap:25px;flex-wrap:wrap}
.previews-toggle{border:1px solid #515744;background:transparent;color:var(--gold-light);font-size:10px;padding:12px 15px;transition:background .2s}
.previews-toggle:hover{background:#303728}
.project-film{aspect-ratio:3/4;height:auto!important}
.project-preview{position:absolute;top:50%;left:0;width:100%;height:133.334%;transform:translateY(-50%);border:0;pointer-events:none}
.project-film .play-button{z-index:2}
@media(max-width:740px){.work-controls{margin-top:24px;gap:18px}.work-controls .underlink{margin-top:0}.project-film{max-height:none}}

